# TeleBot - Solo permitir acceso a webhook.php
# Todo lo demas esta bloqueado por seguridad

# Bloquear acceso directo a archivos PHP internos
<FilesMatch "^(config|autoload|setup)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso a directorios internos
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^src/ - [F,L]
    RewriteRule ^examples/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^storage/ - [F,L]
</IfModule>

# No mostrar listado de directorios
Options -Indexes
